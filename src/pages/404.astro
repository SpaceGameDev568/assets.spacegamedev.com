---
import Layout from "@layouts/Layout.astro";
import ActionButton from "@components/buttons/ActionButton.astro";
---


<Layout title="Asset not found - 404 :(">

	<div id="header-spacer" class="h-12.5 mb-10"/>

	<div>

		<p class="font-bold leading-tight font-heading text-[25vw] m-auto w-fit text-center bg-clip-text text-transparent  bg-[linear-gradient(60deg,#0f68e4,#6a1fbb,#a3159f,#ca3434)]">404</p>

		<div id="content" class="md:border border-white/10 md:bg-background-primary/25 md:backdrop-blur-sm md:box-border w-85.5 border-box m-auto p-5">

			<p class="font-bold text-4xl m-auto w-fit text-center bg-clip-text text-transparent bg-[linear-gradient(60deg,rgb(247,149,51),rgb(243,112,85),rgb(239,78,123),rgb(161,102,171),rgb(80,115,184),rgb(16,152,173),rgb(7,179,155),rgb(111,186,130))]">
				The cake is a lie.
			</p>

			<br/>

			<p class="m-auto w-fit text-white text-xl">
				Sorry, that asset either doesn't exist,
				has been moved or deleted,
				or hasn't been deployed yet.
			</p>
		</div>



	</div>

</Layout>