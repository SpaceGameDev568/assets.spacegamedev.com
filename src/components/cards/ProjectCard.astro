---
import {Image} from "astro:assets";
import ActionButton from "@components/buttons/ActionButton.astro";
import type {ImageMetadata} from "astro";

const props = Astro.props

interface Props {
	title: string;
	image: ImageMetadata;
	description: string;
	link: string;
	github: string;
	variant?: 'Mod' | 'Modpack' | 'Project';
}

const { title, link, variant = 'Mod' } = Astro.props;

const typeVariants: Record<string, string> = {
	Mod: "ficsit.app",
	Modpack: "Modrinth",
	Project: "Website",
};

const variantClass = typeVariants[variant] || typeVariants['Mod'];
---

<div class="w-85 m-2  border border-white/10 bg-background-primary/25 backdrop-blur-sm h-fit">
	
	<div>

		<Image
			src={props.image}
			width="380"
			height="380"
			alt={props.title}
			class="border-b border-white/10 aspect-square"
			quality={90}
		/>

	</div>

	<div class="m-5">

		<h1 class="font-bold font-heading text-2xl text-white">{props.title}</h1>
		<p class="text-gray-400 text-sm h-10">{props.description}</p>
		<br/>

		<hr class="border-white/20 p-5" />

		<div class="flex gap-2 place-content-center">
			<ActionButton
				link={props.link}
				title={variantClass}
				variant="primary"
				target="_blank"
			/>

			<ActionButton
				link={props.github}
				title="GitHub"
				variant="secondary"
				target="_blank"
			/>
		</div>

	</div>
</div>
