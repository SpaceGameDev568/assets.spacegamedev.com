---
import {Image} from "astro:assets";
const props = Astro.props

---

<a href={props.link} class="flex items-center justify-left h-10 ml-auto mr-auto pt-7 pb-7 border-b no-underline border-white/10 text-white select-none box-border text-2xl font-bold hover:bg-spacegamedev-primary duration-300 hover:ring-4 hover:ring-spacegamedev-primary/50 w-full">

    <span class="ml-5">
        <Image
            src={props.image}
            alt={props.alt}
            width="28"
            height="28"
            class="w-7 h-7"
        />
    </span>
    <p class="ml-2"> {props.title} </p>

</a>